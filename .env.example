# Vorlage für .env.local (lokal) bzw. die Umgebungsvariablen im Vercel-Projekt.
# .env.local wird nicht eingecheckt.

# Serverschlüssel für die Analyse. Ohne ihn läuft nur der Weg mit eigenem Key.
ANTHROPIC_API_KEY=sk-ant-...

# Freikontingent-Zähler, Upstash Redis im kostenlosen Tarif.
# Werte stehen im Upstash-Dashboard unter "REST API".
UPSTASH_REDIS_REST_URL=https://....upstash.io
UPSTASH_REDIS_REST_TOKEN=...

# Optional: anderer Anthropic-Endpunkt (Gateway, lokaler Ersatzdienst im Test).
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# Nur lokal: Freikontingent ohne Upstash über einen Speicher im Prozess zählen.
# Nicht in Produktion setzen, dort begrenzt es nichts.
# ALLOW_MEMORY_QUOTA=1

# Nur für die native App (iPhone): absolute Adresse des Proxys.
# EXPO_PUBLIC_API_BASE_URL=https://kuendigo.vercel.app
